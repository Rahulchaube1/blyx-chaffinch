use std::cli;
use std::text;
use std::fs;
use std::buffer;
use gradients;

fn scale_uint(value: str) -> i64 {
    let mut s = value; let mut n = 0;
    if s == "" { stderr_line("Expected a nonnegative decimal integer"); process_exit(2); }
    while s != "" {
        let mut d = 0;
        while d < 10 && !text_starts(s,int_text(d)) { d += 1; }
        if d == 10 || n > (9223372036854775807-d)/10 { stderr_line("Expected a nonnegative i64"); process_exit(2); }
        n = n*10+d; s = text_after(s,int_text(d));
    }
    n
}

fn scale_need(ok: bool) { if !ok { stderr_line("Invalid arguments. See --help"); process_exit(2); } }
fn ch_read_pairs(path: str) -> vector {
    let lines = text_lines(read_text(path));
    let mut result = buffer_fill(args_len(lines)*2,0.0);
    let mut i = 0;
    while i < args_len(lines) {
        let fields = text_split(args_at(lines,i),",");
        scale_need(args_len(fields) == 2);
        let key = scale_uint(text_trim(args_at(fields,0)));
        let value = text_trim(args_at(fields,1));
        scale_need(key <= 9007199254740991 && text_is_number(value));
        result = buffer_set(result,2*i,at([key],0));
        result = buffer_set(result,2*i+1,text_number(value));
        i += 1;
    }
    result
}

pub fn scale_command(argv: arglist) -> bool {
    if args_len(argv) == 0 { return false; }
    let cmd = args_at(argv,0);
    if cmd == "--version" { println!("chaffinch 0.2.0"); return true; }
    if cmd != "reduce" { return false; }
    scale_need(args_len(argv) == 4);
    let count = scale_uint(args_at(argv,1));
    let a = ch_read_pairs(args_at(argv,2)); let b = ch_read_pairs(args_at(argv,3));
    let out = chaffinch_gradient_mean(a,b,count);
    if count < 1 || count > 9007199254740991 || (len(out) == 0 && (len(a) > 0 || len(b) > 0)) { stderr_line("Invalid sparse gradient or example count"); process_exit(2); }
    let mut i = 0;
    while i < len(out) { print!(at(out,i)); print!(","); println!(at(out,i+1)); i += 2; }
    true
}

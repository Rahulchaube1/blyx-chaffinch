use vendor::chaffinch::chaffinch;

fn main() {
    let old = [1, 1, 2, 4];
    let fresh = [2, 2, 3, 4];
    let result = chaffinch_reconcile(old, fresh);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
